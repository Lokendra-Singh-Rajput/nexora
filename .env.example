# =================================================================
# NEXORA DOCKER & AWS EC2 PRODUCTION CONFIGURATION
# =================================================================

# MySQL 8 Credentials
MYSQL_DATABASE=nexoradb
MYSQL_USER=nexora_user
MYSQL_PASSWORD=change_this_to_a_secure_password
MYSQL_ROOT_PASSWORD=change_this_to_a_secure_root_password

# Google Gemini API Key (Optional: system operates with full deterministic fallback if blank)
GEMINI_API_KEY=

# Public Ports (Default: standard HTTP 80)
FRONTEND_PORT=80
